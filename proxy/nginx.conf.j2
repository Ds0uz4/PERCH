# Rendered by controller/proxy_writer.py with the current traffic split, then reloaded.
# STUB (CLAUDE.md §5.2) — weights below are the Jinja2 variables the writer must supply.
#
# nginx drops an upstream server entirely when weight=0 is given, so the writer must emit
# `down` for a zero-weight peer instead. Handle that when implementing Phase 1.

upstream backend {
    server stable:8000 weight={{ stable_weight }};
    server canary:8000 weight={{ canary_weight }};
}

server {
    listen 80;

    location / {
        proxy_pass http://backend;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }
}
