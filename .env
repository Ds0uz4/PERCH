# PERCH — local defaults. Nothing sensitive lives here; the whole stack is localhost-only.
# Ports are deliberately off the common defaults to avoid clashes (see CLAUDE.md §6).

# ---- Host port mappings ----
PROXY_PORT=8080
STABLE_PORT=8091
CANARY_PORT=8092
PROMETHEUS_PORT=9095
GRAFANA_PORT=3005

# ---- Stable service (never faulted) ----
STABLE_ERROR_RATE=0.0
STABLE_LATENCY_MS_MEAN=40
STABLE_LATENCY_MS_JITTER=10

# ---- Canary service (scenario scripts overwrite these) ----
CANARY_ERROR_RATE=0.0
CANARY_LATENCY_MS_MEAN=40
CANARY_LATENCY_MS_JITTER=10
CANARY_DEGRADE_ENDPOINT=
CANARY_DEGRADE_RAMP_SECONDS=

# ---- Controller ----
# tier1 = statistical detector, naive_threshold = baseline for the comparison (CLAUDE.md §5.7)
DECISION_MODE=tier1
POLL_INTERVAL_SECONDS=5
PROMETHEUS_URL=http://prometheus:9090

# ---- Load generator ----
LOADGEN_TARGET=http://localhost:8080
LOADGEN_RPS=50
